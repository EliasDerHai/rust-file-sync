{
  "name": "File Sync Admin",
  "short_name": "File Sync",
  "id": "/app/",
  "start_url": "/app/",
  "scope": "/app/",
  "display": "standalone",
  "share_target": {
    "action": "/app/share",
    "method": "GET",
    "enctype": "application/x-www-form-urlencoded",
    "params": { "title": "title", "text": "text", "url": "url" }
  },
  "background_color": "#1a1a2e",
  "theme_color": "#0f1528",
  "icons": [
    { "src": "/app/assets/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "/app/assets/icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "/app/assets/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ]
}
