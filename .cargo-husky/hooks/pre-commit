#!/bin/bash
# Auto-installed by cargo-husky (see server/Cargo.toml [dev-dependencies]) via
# its build script, which only runs when cargo actually recompiles the
# cargo-husky crate - i.e. a fresh clone/target, not every `cargo test`.
# Cargo caches build script runs, so deleting .git/hooks/pre-commit alone
# won't bring it back. Do not edit .git/hooks/pre-commit directly - edit this
# file instead and run `cargo clean -p cargo-husky && cargo test` to reinstall.
#
# Bumps the workspace's minor version and refreshes the sqlx offline query
# cache (.sqlx/) on every commit.

set -euo pipefail

cd "$(git rev-parse --show-toplevel)"

echo "Bumping workspace minor version..."
cargo run --quiet -p version-bump -- --toml Cargo.toml --semver patch

if ! cargo sqlx --version >/dev/null 2>&1; then
    echo "sqlx-cli not found - install it with:" >&2
    echo "  cargo install sqlx-cli --no-default-features --features sqlite" >&2
    exit 1
fi

echo "Refreshing sqlx offline query cache..."
# ./comptime.db is a throwaway DB used only for `sqlx::query!` compile-time checking
# (see DATABASE_URL in .env) - never used for real data, that's ./data/sqlite.db.
# Rebuilt from scratch every commit so its migration ledger can never drift from
# server/migrations; a migration that fails to apply cleanly here blocks the commit.
rm -f comptime.db
touch comptime.db
cargo sqlx migrate run --source server/migrations
cargo sqlx prepare --workspace
cargo build
git add .sqlx Cargo.toml Cargo.lock 
